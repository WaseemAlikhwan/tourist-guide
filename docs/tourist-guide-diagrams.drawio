  <diagram id="pArch" name="٠ - نظرة عامة والبنية" default="true">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>        <mxCell id="arch0" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;مخططات مشروع دليل السائح - Laravel 10&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;ملف واحد يضم كل مخططات المشروع (UML + متطلبات + قاعدة بيانات)&lt;br/&gt;افتح التبويبات بالأسفل للتنقل بين المخططات&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="55" as="geometry"/>
        </mxCell>        <mxCell id="arch1" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;طبقة العرض (Presentation)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;Blade Views: website / admin / provider&lt;br/&gt;واجهات عربية/إنجليزية + تفاعل المستخدم&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="1040" height="70" as="geometry"/>
        </mxCell>        <mxCell id="arch2" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;طبقة HTTP&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;Controllers: Admin, User, Provider, Public&lt;br/&gt;Middleware: auth, isAdmin, approvedContentProvider, SetLocale&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="1040" height="90" as="geometry"/>
        </mxCell>        <mxCell id="arch3" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;طبقة التطبيق (Application)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;Services: Activity, Destination, Hotel, Weather, Dashboard, ...&lt;br/&gt;Notifications, Jobs, Artisan Commands, Policies&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="1040" height="90" as="geometry"/>
        </mxCell>        <mxCell id="arch4" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;طبقة المجال (Domain)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;Eloquent Models (21): User, Activity, Booking, Destination, ...&lt;br/&gt;Traits: HasLocalizedAttributes, UploadImageTrait&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="1040" height="90" as="geometry"/>
        </mxCell>        <mxCell id="arch5" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;البنية التحتية (Infrastructure)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;MySQL Database + Migrations/Seeders&lt;br/&gt;External: Weather API, Socialite OAuth, File Storage&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="1040" height="90" as="geometry"/>
        </mxCell>        <mxCell id="ae1"  style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="arch1" target="arch2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>        <mxCell id="ae2"  style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="arch2" target="arch3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>        <mxCell id="ae3"  style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="arch3" target="arch4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>        <mxCell id="ae4"  style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="arch4" target="arch5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>        <mxCell id="arch6" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;فهرس الصفحات&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;١ النماذج | ٢ قاعدة البيانات ERD | ٣ الخدمات | ٤ المتحكمات | ٥ الإشعارات&lt;br/&gt;٦ البنية التحتية | ٧ المتطلبات (وظيفية/غير وظيفية) | ٨ حالات الاستخدام | ٩ الدليل&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="1040" height="120" as="geometry"/>
