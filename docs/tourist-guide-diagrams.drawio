        </mxCell>        <mxCell id="m20" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;Weather&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;destination_id&lt;br/&gt;temperature, condition&lt;br/&gt;+ destination()&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
