        </mxCell>        <mxCell id="m24" value="&lt;p style=&quot;margin:4px;font-size:11px;&quot;&gt;&lt;b&gt;Activity&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;uses HasLocalizedAttributes&lt;br/&gt;---&lt;br/&gt;destination_id, provider_id&lt;br/&gt;price, provider_review_status&lt;br/&gt;requires_booking, event_date&lt;br/&gt;---&lt;br/&gt;+ destination() BelongsTo&lt;br/&gt;+ provider() BelongsTo&lt;br/&gt;+ reviews()/approvedReviews()&lt;br/&gt;+ comments()/approvedComments()&lt;br/&gt;+ bookings() HasMany&lt;br/&gt;+ favorites(), gallery() MorphMany&lt;br/&gt;+ associations() HasMany&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
